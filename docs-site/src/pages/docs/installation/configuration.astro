---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import configVars from "../../../data/generated/config.json";

interface ConfigVar {
  name: string;
  type: string;
  default: string;
  required: boolean;
  description: string;
  category: string;
  anchor: string;
}

const vars = configVars as ConfigVar[];

// Logical display order for the category sections. Any category the generator
// emits that is not listed here falls to the end, alphabetically — so adding a
// new var (and a new category) in config.go can never silently drop it.
const categoryOrder = [
  "Server & ports",
  "Datastore",
  "Projects & tenancy",
  "JWT & tokens",
  "Authentication",
  "Password & lockout",
  "Passwordless email login",
  "Passkeys / WebAuthn",
  "TOTP / 2FA",
  "OAuth",
  "QR cross-device login",
  "Phone / SMS verification",
  "Client assurance",
  "Age gating (COPPA)",
  "Identity verification",
  "Email & branding",
  "HTTP, CORS & cookies",
  "Rate limiting",
  "OpenTelemetry",
  "Sweeper (GC)",
  "Audit",
];

const byCategory = new Map<string, ConfigVar[]>();
// anchorByCategory carries the slug emitted by the generator (cmd/docsgen) for
// each category, so this page never re-derives the slug — it consumes the one
// authoritative `anchor` field. All vars in a category share the same anchor.
const anchorByCategory = new Map<string, string>();
for (const v of vars) {
  const list = byCategory.get(v.category) ?? [];
  list.push(v);
  byCategory.set(v.category, list);
  if (!anchorByCategory.has(v.category)) anchorByCategory.set(v.category, v.anchor);
}

const orderIndex = (c: string) => {
  const i = categoryOrder.indexOf(c);
  return i === -1 ? categoryOrder.length : i;
};

const categories = [...byCategory.keys()].sort(
  (a, b) => orderIndex(a) - orderIndex(b) || a.localeCompare(b),
);

const renderDefault = (v: ConfigVar): string => {
  if (v.default !== "") return v.default;
  return v.required ? "(required)" : "(empty)";
};
---

<DocsLayout title="Configuration">
  <h1>Configuration</h1>
  <p>
    All configuration is via environment variables with the
    <code>GATEWAY_</code> prefix. Defaults are tuned for local development;
    production deployments must override at minimum the datastore driver and
    its connection (e.g. <code>GATEWAY_REPO_DRIVER=postgres</code> +
    <code>GATEWAY_POSTGRES_DSN</code>), the JWT key ring, the passkey RP
    ID/origin, and the TOTP encryption key.
  </p>

  <aside class="not-prose my-6 rounded-lg border border-border bg-muted/40 p-4 text-sm">
    <strong>This reference is generated from source.</strong> Every
    <code>GATEWAY_*</code> row below — name, type, default, and whether it is
    required — is extracted from <code>internal/config/config.go</code> by
    <code>cmd/docsgen</code> and a CI drift guard fails the build if these docs
    fall out of sync. To change a variable, its default, or its description,
    edit the Go source and its doc comment (not this page), then regenerate with
    <code>make docs-gen</code>. The conceptual guidance between the tables is
    hand-written.
  </aside>

  <h2>Choosing a datastore driver</h2>
  <p>
    The backing store is selected with <code>GATEWAY_REPO_DRIVER</code>. All
    drivers pass the same conformance suite (identical uniqueness, ordering, and
    error semantics), so behaviour does not change between them — only
    operational characteristics do.
  </p>
  <table>
    <tr><th>Driver</th><th>Use for</th><th>Notes</th></tr>
    <tr><td><code>postgres</code></td><td>Production, multi-node</td><td>The recommended backend. Full control plane (projects, credentials, auth-domains, governance) and row-level security defence-in-depth.</td></tr>
    <tr><td><code>sqlite</code></td><td>Embedded, single-node, dev</td><td>Pure-Go (<code>modernc.org/sqlite</code>, no cgo) — cross-compiles cleanly and runs in-process from a single file or <code>:memory:</code>. Ideal for the embeddable library and small self-host deployments.</td></tr>
    <tr><td><code>memory</code></td><td>Tests / smoke</td><td>Non-durable; state is lost on restart.</td></tr>
  </table>
  <p>
    See <a href="/identity/docs/installation/database-migrations">Database
    migrations</a> for <code>GATEWAY_POSTGRES_AUTO_MIGRATE</code> and the
    migration workflow.
  </p>

  <h2>Environment variable reference</h2>
  <p>
    Every <code>GATEWAY_*</code> variable, grouped by area. A
    <code>Default</code> of <code>(empty)</code> means unset; <code>(required)</code>
    means the variable has no default and the server fails to boot without it
    (often conditionally — e.g. only when a feature or driver is enabled).
  </p>
  {
    categories.map((category) => (
      <section id={anchorByCategory.get(category)}>
        <h3>{category}</h3>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Variable</th>
                <th scope="col">Type</th>
                <th scope="col">Default</th>
                <th scope="col">Required</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              {byCategory.get(category)!.map((v) => (
                <tr>
                  <td><code>{v.name}</code></td>
                  <td>{v.type}</td>
                  <td><code>{renderDefault(v)}</code></td>
                  <td>{v.required ? "yes" : "no"}</td>
                  <td>{v.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <h2 id="wildcard-origin-patterns">Wildcard origin patterns</h2>
  <p>
    Two allowlists name browser origins: <code>GATEWAY_ALLOWED_ORIGINS</code>
    (CORS, together with a project's <code>cors.allowed_origins</code>) and
    <code>GATEWAY_OAUTH_ALLOWED_RETURN_URLS</code> (the hosted OAuth and
    magic-link <code>return_to</code>). Besides exact entries, both accept one
    narrowly scoped pattern form for per-branch preview deployments: a single
    leading wildcard label under a fixed parent domain.
  </p>
  <pre><code>{`GATEWAY_ALLOWED_ORIGINS=https://app.example.app,https://*.previews.example.app
GATEWAY_OAUTH_ALLOWED_RETURN_URLS=https://app.example.app/auth,https://*.previews.example.app/auth`}</code></pre>
  <ul>
    <li>
      <strong>One DNS label.</strong> <code>*</code> matches exactly one
      non-empty label of letters, digits and hyphens, compared
      case-insensitively: <code>feature-1.previews.example.app</code> matches;
      <code>a.b.previews.example.app</code> and <code>previews.example.app</code>
      do not.
    </li>
    <li>
      <strong>Nothing else varies.</strong> The scheme is <code>https</code>
      only, and the port is fixed (443 unless the pattern names one). For
      return URLs the path-prefix rule is unchanged.
    </li>
    <li>
      <strong>CORS echoes the concrete origin.</strong> A matching request gets
      <code>Access-Control-Allow-Origin: &lt;its own Origin&gt;</code> with
      credentials, never the pattern, and every response carries
      <code>Vary: Origin</code>.
    </li>
    <li>
      <strong>Refused at startup:</strong> a bare <code>*</code>,
      <code>https://*</code>, <code>*.com</code>, an <code>http</code> pattern,
      a wildcard anywhere but the leftmost label
      (<code>https://a.*.example.app</code>) or inside a label
      (<code>https://pr-*.example.app</code>), a parent with fewer than two
      labels (<code>https://*.app</code>), and a parent that is itself a
      <a href="https://publicsuffix.org/">public suffix</a> — an ICANN suffix
      such as <code>co.uk</code> or a shared hosting domain such as
      <code>vercel.app</code>, <code>netlify.app</code>, <code>pages.dev</code>
      or <code>github.io</code>, or whose every one-label child is one (a
      wildcard rule such as <code>*.compute.amazonaws.com</code>). Also refused: a parent whose last label is
      numeric (<code>https://*.0.0.1</code>, which would match IP addresses)
      and a port outside 1–65535; a zero-padded port is read as the number.
    </li>
    <li>
      <strong>Per-project lists fail closed.</strong> The admin API refuses an
      invalid entry in a project's <code>cors.allowed_origins</code>. If a
      project's stored list still holds one, the project keeps serving, but
      its whole per-project CORS list is dropped (only
      <code>GATEWAY_ALLOWED_ORIGINS</code> applies to its browser requests)
      and each resolution logs
      <code>project_cors_config_invalid_failing_closed</code>.
    </li>
    <li>
      <strong>Malformed exact return URLs are skipped, not fatal.</strong> A
      <code>GATEWAY_OAUTH_ALLOWED_RETURN_URLS</code> entry without
      <code>*</code> that is not an absolute http(s) URL, or that carries a
      query or fragment, admits nothing and is logged at startup as
      <code>oauth_allowed_return_url_ignored</code>. If no usable entry is
      left, the hosted flow stays off. A <code>return_to</code> containing a
      backslash is always refused, since browsers read it as <code>/</code>
      and it could otherwise step outside a path prefix.
    </li>
  </ul>
  <p>
    The active patterns are logged at startup, in canonical form (lower case,
    default port dropped), next to the exact entries
    (<code>cors_allowed_origins</code> → <code>origin_patterns</code>,
    <code>oauth_hosted_flow_enabled</code> →
    <code>allowed_return_url_patterns</code>).
  </p>
  <aside class="not-prose my-6 rounded-lg border border-border bg-muted/40 p-4 text-sm">
    <strong>Security:</strong> a pattern admits <em>every</em> host under its
    parent. Anything that can publish a site under that parent can make
    credentialed calls to identity from the browser and, through the
    return-URL allowlist, receive a user's one-time OAuth code and redeem it.
    Use a pattern only for a parent domain whose every subdomain you control.
    On a shared preview host, scope the pattern to your own project —
    <code>https://*.&lt;project&gt;.pages.dev</code>, never
    <code>https://*.pages.dev</code>, <code>https://*.vercel.app</code>,
    <code>https://*.netlify.app</code> or <code>https://*.github.io</code>,
    which every other tenant of that host can publish under. Identity refuses
    parents on the public suffix list compiled into the release you run; that
    check is a backstop, not the boundary — a shared parent that is not on the
    list is your responsibility.
  </aside>

  <h2 id="application-scheme-origins">Application-scheme origins</h2>
  <p>
    A desktop or mobile shell that serves its web client from its own scheme
    (an Electron app registering <code>app</code> as a standard, secure scheme,
    or a native web view with a custom scheme handler) runs those pages at an
    origin such as <code>app://example-desktop</code>, and its browser engine
    sends exactly that as the <code>Origin</code> of their requests. To let such
    a client call identity directly, list the origin in
    <code>GATEWAY_ALLOWED_ORIGINS</code> or a project's
    <code>cors.allowed_origins</code>:
  </p>
  <pre><code>{`GATEWAY_ALLOWED_ORIGINS=https://app.example.app,app://example-desktop`}</code></pre>
  <ul>
    <li>
      <strong>Exact, the way the engine sends it.</strong> The entry is
      <code>scheme://host</code>: a lower-case scheme, a host of lower-case DNS
      labels, and nothing else — no port, path, trailing slash, query,
      fragment or userinfo. It matches that origin byte for byte, so a
      request from <code>app://other-desktop</code>,
      <code>web://example-desktop</code>, <code>APP://example-desktop</code>
      or <code>app://example-desktop/</code> is not admitted. A wildcard is
      <code>https</code>-only, as above.
    </li>
    <li>
      <strong>A named host.</strong> The shell must serve its pages from a
      DNS-style host name, each label starting and ending with a letter or
      digit. A placeholder host such as <code>app://-</code> or
      <code>app://.</code> is refused, since it is not a DNS host name. Where
      the helper that serves the shell's pages defaults to one, set its host
      name option to a distinctive name and list that. An IP address
      (<code>app://127.0.0.1</code>) and a host with an underscore are refused
      too: the entry names the application by a DNS host. So is a host whose
      last label is a number (<code>app://1</code>,
      <code>app://example.123</code>, <code>app://0x7f</code>), since an
      engine may read it as an IPv4 address and rewrite it, as Chromium sends
      <code>app://1</code> as <code>app://0.0.0.1</code>.
    </li>
    <li>
      <strong>Refused</strong> at startup, and by the admin API in a
      project's list: any other form of entry on such a scheme (<code>app://example-desktop:8080</code>,
      <code>app://Example-Desktop</code>, <code>app://*.example</code>), and
      every scheme the URL standards give a meaning of their own —
      <code>file:</code>, <code>data:</code>, <code>blob:</code>,
      <code>javascript:</code>, <code>about:</code>,
      <code>filesystem:</code>, <code>ws:</code>, <code>wss:</code> and
      <code>ftp:</code>. Their pages send <code>null</code> (which is refused
      too), the origin of a URL inside them, or an origin every local file
      shares; <code>ws:</code> and <code>wss:</code> name sockets, not pages,
      and browsers no longer load <code>ftp:</code> pages. So are the schemes
      a browser or a platform keeps for its own pages:
      <code>chrome:</code>, <code>chrome-untrusted:</code>,
      <code>chrome-search:</code>, <code>devtools:</code>,
      <code>edge:</code>, <code>view-source:</code>, Firefox's
      <code>resource:</code> and Android's <code>content:</code>. Some of a
      browser's own pages show content it loads from elsewhere, and every
      document a content provider serves shares its origin. That list holds
      the schemes likeliest to be listed by mistake, not every engine's
      internal scheme: list only an origin your own application serves.
    </li>
    <li>
      <strong>No near-miss of <code>http</code> or <code>https</code>.</strong>
      A scheme one edit away from either, such as <code>htps:</code>,
      <code>hhttps:</code> or <code>httsp:</code>, is refused as a
      misspelling rather than read as an application's own.
    </li>
    <li>
      <strong>Logged apart.</strong> The startup line
      <code>cors_allowed_origins</code> lists the
      <code>GATEWAY_ALLOWED_ORIGINS</code> entries on these schemes again
      under <code>app_scheme_origins</code>. A project's list is not logged;
      read it back with the admin API's <code>GetProjectConfig</code>.
    </li>
    <li>
      <strong>Browser extensions.</strong> An extension page's origin, such
      as <code>chrome-extension://</code> followed by the extension's ID,
      follows the same rule and loads as an exact entry. An entry's host is
      lower case, so an origin whose host an engine sends with upper-case
      letters cannot be listed. Firefox gives each
      installation of an extension its own <code>moz-extension://</code>
      host, so an entry for one admits a single browser profile. An ID is
      not proof of which extension is running: an unpacked extension can
      declare any published extension's key and take its ID.
    </li>
    <li>
      <strong>CORS only.</strong> <code>GATEWAY_OAUTH_ALLOWED_RETURN_URLS</code>
      still takes <code>http</code> and <code>https</code> URLs only, and
      passkey ceremonies still verify against
      <code>GATEWAY_PASSKEY_ORIGIN</code> or a project's
      <code>passkey.origin</code>. So hosted OAuth and a magic link cannot
      return to a page on an application scheme, and a passkey cannot sign
      it in; it signs in with a call that returns the tokens itself, such as
      <code>PasswordLogin</code>, <code>VerifyEmailLoginCode</code> or
      <code>NativeOAuthLogin</code>. Identity sets no session cookie: the sign-in
      calls return the access and refresh tokens, and the client keeps them
      and sends them itself, the access token as a bearer token and the
      refresh token to <code>RefreshToken</code>.
    </li>
  </ul>
  <aside class="not-prose my-6 rounded-lg border border-border bg-muted/40 p-4 text-sm">
    <strong>Security:</strong> an entry for an origin your own application
    serves admits no website. A browser
    sets <code>Origin</code> itself and page script cannot change it; a page
    loaded over <code>http</code> or <code>https</code> always presents that
    origin, a sandboxed or <code>data:</code> page presents <code>null</code>,
    and a <code>file:</code> page presents <code>null</code> or, in some
    shells, <code>file://</code>; both are refused. Only an application that
    registered the scheme
    and loads its own pages from it presents the origin. A non-browser client
    can send any <code>Origin</code> it likes, with or without this entry: CORS
    governs what browsers let pages read, not who can call the server.
    The origin is not an application's identity, though: another application
    on the same machine can register the same scheme, and a framework's
    default origin (such as <code>capacitor://localhost</code> or
    <code>tauri://localhost</code>) is shared by every app built on it. Give
    your shell a distinctive host, and list only an origin your own
    application serves.
  </aside>

  <h2>Password reset &amp; signup toggles</h2>
  <p>
    When <code>GATEWAY_PASSWORD_RESET_ENABLED=false</code>,
    <code>RequestPasswordReset</code> still returns success so callers cannot
    use it to enumerate accounts, but Identity does not create a reset token
    or send recovery email. A refused
    <code>product</code> or <code>return_to</code> (see
    <a href="#reset-and-verification-links">Reset and verification links</a>)
    still fails the call with <code>invalid_argument</code>, whether or not
    reset is enabled. Likewise <code>GATEWAY_PASSWORD_SIGNUP_ENABLED=false</code>
    rejects self-serve <code>PasswordSignup</code> and <code>UsernameSignup</code> while leaving admin- and
    invitation-driven account creation intact. See the
    <a href="/identity/docs/operations/password-toggle-rollout">password-toggle
    rollout runbook</a>.
  </p>

  <h2>Email branding &amp; deliverability</h2>
  <p>
    Transactional emails (magic link, login code, verification, password
    reset, invitations) carry optional branding. Every field is optional:
    when unset, mail is byte-compatible with the default unbranded look and
    the From address falls back to <code>GATEWAY_SMTP_FROM</code>. The
    <code>GATEWAY_EMAIL_BRAND_*</code> variables above are the
    <strong>global defaults</strong> — a single server serving two products
    overrides them per project (see below).
  </p>
  <h3>Per-project branding (one server, two products)</h3>
  <p>
    A project's <code>config_json</code> may carry a <code>branding</code> and a
    <code>passkey</code> block that override the global defaults for requests
    resolved to that project (by credential key or Host header). Per-field
    precedence is <em>per-project value → global default → unbranded/legacy</em>.
    This lets one deployment brand, say, a kids product and a B2B product
    distinctly, and bind passkeys to each product's own relying-party ID so a
    passkey registered on <code>kids.example.com</code> validates under that
    product's RP-ID rather than the other's.
  </p>
  <pre><code>{`{
  "branding": {
    "product_name": "Acme Kids",
    "email_from": "no-reply@kids.example.com",
    "email_from_name": "Acme Kids",
    "logo_url": "https://kids.example.com/logo.png",
    "primary_color": "#1a73e8",
    "support_email": "help@kids.example.com"
  },
  "passkey": {
    "rp_id": "kids.example.com",
    "rp_name": "Acme Kids",
    "origin": "https://kids.example.com"
  }
}`}</code></pre>
  <h3>Per-product branding (one project, several products)</h3>
  <p>
    A project whose account pool signs into several products can brand the
    password-reset and email-verification emails per product. Put a
    <code>branding</code> block, with the same fields, under the product in
    the project's <code>products</code> block. It applies when the request
    names that product in its <code>product</code> field (see
    <a href="#reset-and-verification-links">reset and verification links</a>).
    Per-field precedence becomes <em>product value → per-project value →
    global default → unbranded/legacy</em>. A request that names no product,
    or a product without a <code>branding</code> block, gets the project's
    branding. Other emails do not use it.
  </p>
  <pre><code>{`{
  "branding": { "product_name": "Acme", "email_from_name": "Acme" },
  "products": {
    "kids": {
      "minimum_age_band": "child",
      "branding": {
        "product_name": "Acme Kids",
        "email_from": "no-reply@kids.example.com",
        "email_from_name": "Acme Kids",
        "logo_url": "https://kids.example.com/logo.png"
      }
    }
  }
}`}</code></pre>
  <h3>Deliverability (DKIM / SPF / DMARC)</h3>
  <p>
    Branding the From address only helps if the receiving mail server trusts
    it. Configure your sending domain's DNS so auth mail is not flagged as
    phishing:
  </p>
  <ul>
    <li><strong>SPF</strong>: publish a TXT record authorising your SMTP relay
    to send for the From domain (e.g. <code>v=spf1 include:your-relay -all</code>).</li>
    <li><strong>DKIM</strong>: enable DKIM signing at your relay and publish the
    public key as a TXT record so receivers can verify the signature.</li>
    <li><strong>DMARC</strong>: publish a <code>_dmarc</code> policy aligning SPF
    and DKIM with the From domain (start with <code>p=none</code> for
    monitoring, then tighten to <code>quarantine</code>/<code>reject</code>).</li>
  </ul>
  <p>
    When you set a per-project <code>email_from</code> on a custom domain, that
    domain needs its own SPF/DKIM/DMARC records.
  </p>

  <h2 id="reset-and-verification-links">Reset and verification links</h2>
  <p>
    Password-reset and email-verification emails link to a page that redeems
    the token through <code>ConfirmPasswordReset</code> or
    <code>VerifyEmail</code>. Identity does not serve that page. By default
    the link is <code>/auth/reset-password?token=…</code> or
    <code>/auth/verify-email?token=…</code> on the request's project primary
    auth domain, else on <code>GATEWAY_APP_BASE_URL</code>, so your app must
    serve those paths.
  </p>
  <p>
    A verification link proves only the address it was mailed to. Once the
    account holds another address, <code>VerifyEmail</code> refuses the link
    with <code>unauthenticated</code> and spends it; send a new one to the
    current address. Another spelling of the same mailbox (capitals, or a
    dotted Gmail address) still verifies. A reset link is bound the same way:
    once the account holds another address, <code>ConfirmPasswordReset</code>
    refuses it as an invalid link and spends it.
  </p>
  <p>
    When the pages live somewhere else, such as a sign-in hub that serves
    several products, set <code>GATEWAY_EMAIL_LINK_BASE_URL</code>. The links
    become <code>&lt;base&gt;/reset-password?token=…</code> and
    <code>&lt;base&gt;/verify-email?token=…</code> for every project, and
    take precedence over a project's primary auth domain. The value must be an
    absolute <code>https</code> URL (<code>http</code> only for a loopback
    host) with no userinfo, query or fragment; a path prefix is kept, and a
    trailing slash is ignored. Identity refuses to start with any other value.
    Magic-link, email-change and invitation links are not affected.
  </p>
  <p>
    The three calls that send these emails, <code>RequestPasswordReset</code>,
    <code>PasswordSignup</code> and <code>SendEmailVerification</code>, take
    two optional fields for the page. Each is appended to the link after the
    token, URL-encoded, and only when it is set:
  </p>
  <ul>
    <li>
      <code>product</code> becomes <code>&amp;product=&lt;slug&gt;</code>: the
      product the request is for, as in the hub's own
      <code>?product=</code>. It is trimmed and lower-cased, and must then be
      1–64 characters of <code>a-z</code>, <code>0-9</code>, <code>-</code>
      and <code>_</code>, starting with a letter or digit.
    </li>
    <li>
      <code>return_to</code> becomes <code>&amp;redirect=&lt;url&gt;</code>:
      where the page sends the user afterwards. It must match
      <code>GATEWAY_OAUTH_ALLOWED_RETURN_URLS</code>, the allowlist hosted
      OAuth and magic links use, so an email never carries a redirect you do
      not trust. With that allowlist empty, every <code>return_to</code> is
      refused.
    </li>
  </ul>
  <p>
    A refused <code>product</code> or <code>return_to</code> fails the call
    with <code>invalid_argument</code> before anything is created or sent.
    The check reads only the request, so <code>RequestPasswordReset</code>
    gives the same answer for every address and still reveals nothing about
    which accounts exist.
  </p>
  <p>
    The check covers only the links Identity sends. The page receives
    <code>redirect</code> and <code>product</code> as ordinary query
    parameters, which anyone can put on a link by hand next to a token of
    their own, so the page must check <code>redirect</code> against its own
    allowlist before following it.
  </p>
  <p>
    The other verification emails use the same base with neither field: the
    one sent when <code>UpgradeAnonymousAccount</code> or
    <code>AcceptInvitation</code> leaves an address unverified, and the one a
    sign-in refused under <code>GATEWAY_AUTH_REQUIRE_VERIFIED_EMAIL</code>
    sends.
  </p>
  <pre><code>{`GATEWAY_EMAIL_LINK_BASE_URL=https://signin.example.com
GATEWAY_OAUTH_ALLOWED_RETURN_URLS=https://kids.example.com

# RequestPasswordReset {"email": "…", "product": "kids", "returnTo": "https://kids.example.com/home"}
https://signin.example.com/reset-password?token=…&product=kids&redirect=https%3A%2F%2Fkids.example.com%2Fhome`}</code></pre>

  <h2>Boolean parsing</h2>
  <p>
    <code>GATEWAY_*</code> boolean variables accept (case-insensitive)
    <code>true</code> / <code>1</code> / <code>yes</code> for true and
    <code>false</code> / <code>0</code> / <code>no</code> for false. Any
    other value falls back to the default.
  </p>
</DocsLayout>
