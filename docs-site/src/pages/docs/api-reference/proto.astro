---
import DocsLayout from "../../../layouts/DocsLayout.astro";

// The HTML reference is generated by protoc-gen-doc (buf.gen.docs.yaml) into
// public/proto/index.html during the docs deploy. Embed it in an iframe so the
// docs chrome (sidebar, wayfinding) stays around the standalone reference.
const base = import.meta.env.BASE_URL;
const protoUrl = `${base}/proto/index.html`.replace(/\/{2,}/g, "/");
---

<DocsLayout title="Proto Reference">
  <h1>Proto Reference</h1>
  <p>
    Full message- and service-level reference generated directly from
    <a
      href="https://github.com/elloloop/identity/blob/main/proto/identity/v1/identity.proto"
      ><code>proto/identity/v1/identity.proto</code></a
    >. The same schema is published to the
    <a href="https://buf.build/elloloop/identity">Buf Schema Registry</a>; for
    the interactive request explorer see the
    <a href="/identity/docs/api-reference/rest">API Reference (OpenAPI)</a>.
  </p>

  <iframe
    src={protoUrl}
    title="Generated proto reference"
    class="not-prose"
    style="width:100%;height:80vh;border:1px solid var(--sl-color-gray-5, #e5e7eb);border-radius:8px;"
    loading="lazy"></iframe>

  <p>
    Prefer it full-screen? <a href={protoUrl}>Open the raw proto reference</a>.
  </p>
</DocsLayout>
