    <tr><td><code>ListHelpRequests</code></td><td>auth (admin)</td><td>Admin dashboard: list pending tickets.</td></tr>
    <tr><td><code>ResolveHelpRequest</code></td><td>auth (admin)</td><td>Resolve or reject a help request.</td></tr>
  </table>

