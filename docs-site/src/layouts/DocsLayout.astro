---
import "../styles/global.css";
import {
  AppShell,
  AppShellHeader,
  AppShellSidebar,
  AppShellMain,
  AppShellContent,
  AppShellMobileNav,
  AppShellOverlay,
  ThemeScript,
  ThemeToggle,
} from "@refraction-ui/astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "Docs", href: "/identity/" },
  { label: "GitHub", href: "https://github.com/elloloop/identity" },
  { label: "Container", href: "https://github.com/elloloop/identity/pkgs/container/identity" },
];

const sidebarSections = [
  {
    title: "Getting Started",
    items: [
      { label: "Introduction", href: "/identity/" },
      { label: "What is Identity", href: "/identity/docs/introduction" },
      { label: "Quick Start", href: "/identity/docs/quickstart" },
    ],
  },
  {
    title: "Concepts",
    items: [
      { label: "Architecture", href: "/identity/docs/concepts/architecture" },
      { label: "Auth Model", href: "/identity/docs/concepts/auth-model" },
      { label: "Sessions", href: "/identity/docs/concepts/sessions" },
      { label: "Multi-Tenancy", href: "/identity/docs/concepts/multi-tenancy" },
    ],
  },
  {
    title: "Installation",
    items: [
      { label: "Docker", href: "/identity/docs/installation/docker" },
      { label: "Configuration", href: "/identity/docs/installation/configuration" },
      { label: "JWT Keys", href: "/identity/docs/installation/jwt-keys" },
    ],
  },
  {
    title: "Authentication",
    items: [
      { label: "Password", href: "/identity/docs/auth/password" },
      { label: "Invitations", href: "/identity/docs/auth/invitations" },
      { label: "OAuth", href: "/identity/docs/auth/oauth" },
      { label: "Passkey", href: "/identity/docs/auth/passkey" },
      { label: "TOTP (2FA)", href: "/identity/docs/auth/totp" },
    ],
  },
  {
    title: "Users & Groups",
    items: [
      { label: "User Management", href: "/identity/docs/users/management" },
    ],
  },
  {
    title: "API Reference",
    items: [
      { label: "gRPC Services", href: "/identity/docs/api-reference/grpc" },
    ],
  },
  {
    title: "Operations",
    items: [
      { label: "Audit Logging", href: "/identity/docs/operations/audit-logging" },
      { label: "Observability", href: "/identity/docs/operations/observability" },
    ],
  },
  {
    title: "Deployment",
    items: [
      { label: "GitHub Actions", href: "/identity/docs/deployment/github-actions" },
      { label: "Kubernetes", href: "/identity/docs/deployment/kubernetes" },
    ],
  },
  {
    title: "Examples",
    items: [
      { label: "Multi-App SSO", href: "/identity/docs/examples/multi-app-sso" },
      { label: "Passwordless Onboarding", href: "/identity/docs/examples/passwordless-onboarding" },
      { label: "Key Rotation", href: "/identity/docs/examples/key-rotation" },
    ],
  },
];

const isActive = (href: string) =>
  currentPath === href || currentPath === href + "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Identity Documentation</title>
    <meta
      name="description"
      content="Identity — single-container authentication and user-management service. JWT, passkeys, TOTP, OAuth, sessions, audit logging."
    />
    <ThemeScript />
  </head>
  <body class="bg-background text-foreground antialiased">
    <AppShell
      sidebarWidth="17rem"
      sidebarCollapsedWidth="4rem"
      headerHeight="3.5rem"
      mobileBreakpoint={768}
      tabletBreakpoint={1024}
    >
      <AppShellHeader>
        <div
          class="flex h-14 items-center gap-6 border-b border-border bg-background px-4 md:px-6"
        >
          <AppShellMobileNav />
          <a
            href="/identity/"
            class="flex items-center gap-2 font-bold"
          >
            <div
              class="h-6 w-6 rounded-md bg-gradient-to-br from-primary to-primary/60"
            >
            </div>
            <span class="text-primary">Identity</span>
            <span class="text-foreground">Docs</span>
          </a>
          <nav class="hidden items-center gap-5 md:flex">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
          <div class="ml-auto flex items-center gap-3">
            <ThemeToggle variant="segmented" />
          </div>
        </div>
      </AppShellHeader>

      <AppShellSidebar>
        <nav class="flex flex-col gap-1 overflow-y-auto p-4">
          {
            sidebarSections.map((section) => (
              <div class="mb-4">
                <div class="mb-2 px-3 text-xs font-bold uppercase tracking-wider text-muted-foreground">
                  {section.title}
                </div>
                {section.items.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      "block rounded-md px-3 py-1.5 text-sm transition-colors",
                      isActive(item.href)
                        ? "bg-primary/10 font-medium text-primary"
                        : "text-muted-foreground hover:bg-muted hover:text-foreground",
                    ]}
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            ))
          }
        </nav>
      </AppShellSidebar>

      <AppShellMain>
        <AppShellContent>
          <article class="prose mx-auto w-full max-w-4xl px-6 py-10 md:px-10">
            <slot />
          </article>
        </AppShellContent>
      </AppShellMain>

      <AppShellOverlay />
    </AppShell>
  </body>
</html>
